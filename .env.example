# Copy to .env and fill in. Never commit .env.

# Identifies this program to every source. Keep it descriptive; do not
# impersonate a browser.
COLLECTOR_USER_AGENT="crypto_institution_research-collector/0.1 (+https://github.com/tlzkrh1029/crypto_institution_research)"

# Required by the SEC fair access policy for sec.gov sources.
# Format from the SEC example: "Sample Company Name AdminContact@<domain>.com".
# SEC sources are skipped while this is empty.
SEC_USER_AGENT=""

# Optional. Ping URL of an external heartbeat monitor (e.g. healthchecks.io).
# The URL itself is a credential.
HEARTBEAT_URL=""

# Where the SQLite database and logs live (git-ignored).
COLLECTOR_DATA_DIR="data"

# Notifier: "log" (log file only) or "telegram" (log file and a Telegram chat).
# docs/setup-macos.md explains how to create the bot and find the chat id.
NOTIFIER="log"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
